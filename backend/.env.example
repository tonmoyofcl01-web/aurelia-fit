PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Dhaka
MONGODB_URI=
JWT_SECRET=
# Required: generate a random secret with at least 32 characters.
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Used only when creating the original/default gym workspace on first startup.
GYM_NAME=Aurelia Fit
OWNER_NAME=Gym Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
# Set a unique owner password before starting the backend.

# Public gym registration creates a separate workspace and owner account.
# Registration is rate-limited. No email verification flow is currently included.
